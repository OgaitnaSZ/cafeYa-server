generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model audit_log {
  id             Int              @id @default(autoincrement())
  created_at     DateTime         @default(now()) @db.Timestamp(6)
  usuario_id     String           @db.Uuid
  nombre_usuario String           @db.VarChar(255)
  rol_usuario    String           @db.VarChar(100)
  accion         audit_log_accion
  entidad        String           @db.VarChar(100)
  entidad_id     String           @db.VarChar(100)
  cambios        Json
  descripcion    String
  ip             String           @db.VarChar(45)
  user_agent     String           @db.VarChar(255)
  usuario        usuario          @relation(fields: [usuario_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model calificacion {
  id             String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  pedido_id      String   @db.Uuid
  puntuacion     Int
  resena         String?
  created_at     DateTime @default(now()) @db.Timestamp(6)
  nombre_cliente String   @db.VarChar(255)
  pedido         pedido   @relation(fields: [pedido_id], references: [pedido_id], onDelete: NoAction, onUpdate: NoAction)
}

model categoria {
  categoria_id Int        @id @default(autoincrement())
  nombre       String     @db.VarChar(100)
  emoji        String     @db.VarChar(10)
  created_at   DateTime   @default(now()) @db.Timestamp(6)
  producto     producto[]
}

model cliente {
  cliente_id       String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  nombre           String   @db.VarChar(255)
  telefono         String?  @db.VarChar(20)
  email            String?  @db.VarChar(255)
  duracion_minutos Int
  created_at       DateTime @default(now()) @db.Timestamp(6)
  pedido           pedido[]
}

model mesa {
  mesa_id     String      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  numero      Int?        @unique
  codigo      String      @db.Char(4)
  estado      mesa_estado @default(Disponible)
  created_at  DateTime    @default(now()) @db.Timestamp(6)
  updated_at  DateTime    @default(now()) @db.Timestamp(6)
  is_archived Boolean     @default(false)
  pedido      pedido[]
}

model pago {
  pago_id       String             @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  pedido_id     String             @db.Uuid
  medio_de_pago pago_medio_de_pago
  monto         Decimal            @db.Decimal(10, 2)
  iva           Decimal            @db.Decimal(10, 2)
  monto_final   Decimal            @db.Decimal(10, 2)
  created_at    DateTime           @default(now()) @db.Timestamp(6)
  pedido        pedido             @relation(fields: [pedido_id], references: [pedido_id], onDelete: NoAction, onUpdate: NoAction)
}

model pedido {
  pedido_id       String            @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  numero_pedido   String            @unique @db.VarChar(20)
  cliente_id      String            @db.Uuid
  nombre_cliente  String            @db.VarChar(255)
  mesa_id         String            @db.Uuid
  nota            String?
  precio_total    Decimal           @db.Decimal(10, 2)
  estado          pedido_estado     @default(Pendiente)
  created_at      DateTime          @default(now()) @db.Timestamp(6)
  pedido_padre    String?           @db.Uuid
  calificacion    calificacion[]
  pago            pago[]
  cliente         cliente           @relation(fields: [cliente_id], references: [cliente_id], onDelete: NoAction, onUpdate: NoAction)
  mesa            mesa              @relation(fields: [mesa_id], references: [mesa_id], onDelete: NoAction, onUpdate: NoAction)
  pedido          pedido?           @relation("pedidoTopedido", fields: [pedido_padre], references: [pedido_id], onDelete: NoAction, onUpdate: NoAction)
  other_pedido    pedido[]          @relation("pedidoTopedido")
  pedido_producto pedido_producto[]
}

model pedido_producto {
  pedido_producto_id Int      @id @default(autoincrement())
  pedido_id          String   @db.Uuid
  producto_id        String   @db.Uuid
  cantidad           Int      @default(1)
  precio_unitario    Decimal  @db.Decimal(10, 2)
  pedido             pedido   @relation(fields: [pedido_id], references: [pedido_id], onDelete: Cascade, onUpdate: NoAction)
  producto           producto @relation(fields: [producto_id], references: [producto_id], onDelete: NoAction, onUpdate: NoAction)
}

model producto {
  producto_id     String            @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  nombre          String            @db.VarChar(255)
  descripcion     String
  categoria_id    Int
  imagen_url      String?           @db.VarChar(500)
  precio_unitario Decimal           @db.Decimal(10, 2)
  created_at      DateTime          @default(now()) @db.Timestamp(6)
  updated_at      DateTime          @default(now()) @db.Timestamp(6)
  destacado       Boolean           @default(false)
  estado          producto_estado   @default(Inactivo)
  stock           Int               @default(0)
  is_archived     Boolean           @default(false)
  pedido_producto pedido_producto[]
  categoria       categoria         @relation(fields: [categoria_id], references: [categoria_id], onDelete: NoAction, onUpdate: NoAction)
}

model usuario {
  id          String      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  nombre      String      @db.VarChar(255)
  email       String      @unique @db.VarChar(255)
  password    String      @db.VarChar(255)
  rol         usuario_rol
  created_at  DateTime    @default(now()) @db.Timestamp(6)
  updated_at  DateTime    @default(now()) @db.Timestamp(6)
  is_archived Boolean     @default(false)
  audit_log   audit_log[]
}

enum audit_log_accion {
  CREATE
  UPDATE
  DELETE
}

enum mesa_estado {
  Disponible
  Ocupada
}

enum pago_medio_de_pago {
  app
  tarjeta
  efectivo
}

enum pedido_estado {
  Pendiente
  En_preparacion
  Listo
  Entregado
}

enum producto_estado {
  Activo
  Inactivo
}

enum usuario_rol {
  encargado
  cocina
  admin
}
